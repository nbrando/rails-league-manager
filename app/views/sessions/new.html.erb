<% content_for :page_header do %>
  <h1>Log In</h1>
  <ul class="breadcrumb">
    <li><%= link_to "Home", root_path %></li>
    <li>Log In</li>
  </ul>
<% end %>

<div style="max-width: 480px; margin: 0 auto;">
  <div class="section-block">
    <div class="section-block-header">
      <h3>Sign In</h3>
    </div>
    <div class="section-block-body">
      <%= form_with url: login_path, class: "form-sports", local: true do |f| %>

        <% if flash[:alert] %>
          <div class="alert alert-danger">
            <%= flash[:alert] %>
          </div>
        <% end %>

        <div class="form-group">
          <%= f.label :email %>
          <%= f.email_field :email, placeholder: "your@email.com" %>
        </div>
        <div class="form-group">
          <%= f.label :password %>
          <%= f.password_field :password, placeholder: "Password" %>
        </div>

        <%= f.submit "Log In", class: "btn-sports btn-sports-primary" %>
        <span style="margin-left: 1rem; font-size: 0.8rem; color: var(--text-muted);">
          Don't have an account? <%= link_to "Sign Up", new_user_path %>
        </span>

      <% end %>
    </div>
  </div>
</div>